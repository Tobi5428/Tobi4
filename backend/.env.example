# Google reCAPTCHA v3 secret (server only; never use a VITE_ prefix)
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Backend auth and database configuration
PORT=5000
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
MONGO_URI=
DATABASE_URL=

# Required for email-based login OTP and password/email verification messages
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# Set the public frontend site key in the repository-root .env or .env.local:
# VITE_RECAPTCHA_SITE_KEY=
